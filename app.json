{
  "expo": {
    "name": "emballage.tn",
    "slug": "emballagetn",
    "scheme": "sky.app.emballage",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/cc42f986-4880-46a0-b720-caaa61ba920b",
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.5.0",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sky.app.emballage",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "sky.app.emballage",
      "versionCode": 2,
      "icon": "./assets/icon.png"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "inachet33-2-2",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1E6B4C",
          "sounds": []
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application accède à vos photos pour illustrer les articles.",
          "cameraPermission": "L'application utilise la caméra pour photographier les articles."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "L'application utilise votre position pour localiser le point de livraison.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cc42f986-4880-46a0-b720-caaa61ba920b"
      }
    }
  }
}
